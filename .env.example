# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require

# Security
ENCRYPTION_KEY=GENERATE_WITH_python_-c_from_cryptography.fernet_import_Fernet_print(Fernet.generate_key().decode())
SESSION_DAYS=30
INSECURE_PASSWORD_RESET=false
INSTALLER_ADMIN_EMAILS=admin@yourdomain.com

# App
SEED_DEMO_DATA=false
PUBLIC_BASE_URL=https://your-domain.example
ENABLE_DOCS=false

# Meta / WhatsApp Tech Provider
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Current Embedded Signup configuration generation. Use v4 for a new configuration.
META_EMBEDDED_SIGNUP_VERSION=v4
# Keep this aligned with the Graph API version supported by your Meta app.
META_GRAPH_API_VERSION=v25.0
# REQUIRED. An empty value makes Meta webhook verification fail. deploy/azure-deploy.sh generates one for you.
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-string
META_TEMPLATE_NAME=manweta_payment_reminder
META_TEMPLATE_LANGUAGE=en_US
# Optional fixed six-digit registration PIN. Leave empty to generate and encrypt a per-tenant PIN.
META_PHONE_REGISTRATION_PIN=
META_AUTO_REGISTER_PHONE=true
META_HTTP_TIMEOUT_SECONDS=20

# Azure Blob installer storage
WINDOWS_INSTALLER_VERSION=v1.4.2
WINDOWS_INSTALLER_BLOB_URL=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=https://YOURACCOUNT.blob.core.windows.net
AZURE_STORAGE_CONTAINER=installers

# Temporary App Review demo only. Never put these values in frontend JavaScript.
# Use the temporary token and test Phone Number ID from WhatsApp > API Setup.
META_DEMO_ACCESS_TOKEN=
META_DEMO_PHONE_NUMBER_ID=
# One recipient phone number verified/allowed in Meta API Setup, digits only with country code.
META_DEMO_RECIPIENT=
